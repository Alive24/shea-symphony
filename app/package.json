{
  "name": "shea-symphony-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:tauri": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "node --test",
    "test:build": "npm run build && SHEA_SYMPHONY_APP_REQUIRE_BUILD=1 node --test test/static-build.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.22.0",
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tauri-apps/cli": "^2.9.0",
    "@tsconfig/svelte": "latest",
    "@types/node": "^25.9.1",
    "svelte": "latest",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "latest",
    "storybook": "^10.4.2",
    "@storybook/svelte-vite": "^10.4.2",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "vitest": "^4.1.8",
    "playwright": "^1.60.0",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8"
  }
}
