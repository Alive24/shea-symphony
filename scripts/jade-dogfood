#!/bin/sh
set -eu

WORKFLOW="examples/github-project-workflow.md"
MAX_ITERATIONS="1"
MODE="dry-run"
CONFIRM_WRITE="false"

usage() {
  cat <<'EOF'
Usage: scripts/jade-dogfood [--dry-run | --write --confirm-write] [--workflow PATH] [--max-iterations N]

Runs operator preflights for supervised Jade Symphony dogfood.

Options:
  --dry-run            Preview the dogfood command without tracker mutation.
  --write              Run one bounded live write-mode tick after preflight.
  --confirm-write      Required with --write.
  --workflow PATH      Workflow markdown path. Default: examples/github-project-workflow.md
  --max-iterations N   Bounded run-loop iterations. Default: 1
  --help               Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      MODE="dry-run"
      shift
      ;;
    --write)
      MODE="write"
      shift
      ;;
    --confirm-write)
      CONFIRM_WRITE="true"
      shift
      ;;
    --workflow)
      WORKFLOW="${2:?missing workflow path}"
      shift 2
      ;;
    --max-iterations)
      MAX_ITERATIONS="${2:?missing max iteration count}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

BIN="$REPO_ROOT/target/debug/jade-symphony"
FAILED="false"

check() {
  label="$1"
  shift
  if "$@" >/tmp/jade-dogfood-check.out 2>/tmp/jade-dogfood-check.err; then
    echo "preflight ok: $label"
  else
    FAILED="true"
    echo "preflight failed: $label" >&2
    sed 's/^/  /' /tmp/jade-dogfood-check.err >&2 || true
  fi
}

echo "JADE SYMPHONY DOGFOOD PREFLIGHT"
echo "repo=$REPO_ROOT"
echo "workflow=$WORKFLOW"
echo "mode=$MODE"
echo "max_iterations=$MAX_ITERATIONS"
echo "binary=$BIN"

if [ "$MODE" = "write" ] && [ "$CONFIRM_WRITE" != "true" ]; then
  echo "preflight failed: --write requires --confirm-write" >&2
  exit 2
fi

check "workflow file exists" test -f "$WORKFLOW"
check "built binary exists" test -x "$BIN"
check "git repository" git rev-parse --show-toplevel
check "gh executable" command -v gh
check "gh auth status" gh auth status

if [ -x "$BIN" ]; then
  check "workflow validates" "$BIN" validate "$WORKFLOW"
fi

echo
echo "Recommended commands:"
echo "- preview: scripts/jade-dogfood --dry-run"
echo "- supervised write: scripts/jade-dogfood --write --confirm-write --max-iterations 1"
echo "- inspect: $BIN inspect $WORKFLOW"
echo "- resume tick: $BIN run-loop $WORKFLOW --max-iterations 1 --write"

if [ "$FAILED" = "true" ]; then
  echo "dogfood_preflight=failed" >&2
  exit 1
fi

if [ "$MODE" = "dry-run" ]; then
  echo "dogfood_preflight=ok"
  exec "$BIN" run-loop "$WORKFLOW" --max-iterations "$MAX_ITERATIONS" --dry-run
fi

echo "dogfood_preflight=ok"
exec "$BIN" run-loop "$WORKFLOW" --max-iterations "$MAX_ITERATIONS" --write
